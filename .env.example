# Runtime environment: development, production, or test.
NODE_ENV=development

# Address to bind. Defaults to 127.0.0.1 in development and test, and 0.0.0.0 in production.
HOST=127.0.0.1

# TCP port to listen on.
PORT=3000

# Public site URL. Use http or https with no trailing slash.
PUBLIC_URL=

# Directory for the embedded database and other local data.
DATA_DIR=./data

# Postgres connection string. Leave empty to use the embedded database.
DATABASE_URL=

# Owner password, at least 12 characters. bun run setup fills this in.
ADMIN_PASSWORD=

# Session secret, at least 32 characters. bun run setup fills this in.
SESSION_SECRET=

# Trusted reverse proxies. Leave empty or set false to disable. Use a whole number from 1 to 10 for proxy hops, or a comma-separated list of IPs, CIDR ranges, or the names loopback, linklocal, and uniquelocal.
TRUST_PROXY=

# Shared secret sent with outbound webhooks.
WEBHOOK_SECRET=

# Base URL of an OpenAI-compatible API.
AI_BASE_URL=

# API key for the AI provider.
AI_API_KEY=

# Model name for the AI provider.
AI_MODEL=
