{
  "name": "friendform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "bun@1.3.5",
  "scripts": {
    "dev": "tsx scripts/setup.ts --ensure && tsx watch --clear-screen=false server/index.ts",
    "build": "vite build && esbuild server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server.mjs",
    "start": "NODE_ENV=production node dist/server.mjs",
    "setup": "tsx scripts/setup.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "check:boot": "tsx scripts/boot-check.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.8",
    "drizzle-orm": "0.45.2",
    "express": "5.2.1",
    "express-rate-limit": "8.5.2",
    "helmet": "8.1.0",
    "pg": "8.16.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "zod": "4.3.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.18",
    "@types/express": "5.0.6",
    "@types/node": "25.2.3",
    "@types/pg": "8.16.0",
    "@types/react": "19.2.8",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.7.0",
    "drizzle-kit": "0.31.8",
    "esbuild": "0.25.12",
    "tailwindcss": "4.1.18",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vite": "8.1.3",
    "vitest": "4.1.8"
  }
}
