{
  "name": "friendform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "bun@1.3.5",
  "scripts": {
    "dev": "tsx scripts/setup.ts --ensure && tsx watch --clear-screen=false server/index.ts",
    "build": "vite build && esbuild server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server.mjs",
    "start": "NODE_ENV=production node dist/server.mjs",
    "setup": "tsx scripts/setup.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project node && vitest run --project client",
    "db:generate": "drizzle-kit generate",
    "check:boot": "tsx scripts/boot-check.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@radix-ui/react-alert-dialog": "1.1.15",
    "@radix-ui/react-checkbox": "1.3.3",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-dropdown-menu": "2.1.16",
    "@radix-ui/react-label": "2.1.8",
    "@radix-ui/react-popover": "1.1.15",
    "@radix-ui/react-progress": "1.1.8",
    "@radix-ui/react-radio-group": "1.3.8",
    "@radix-ui/react-select": "2.2.6",
    "@radix-ui/react-separator": "1.1.8",
    "@radix-ui/react-slot": "1.2.4",
    "@radix-ui/react-switch": "1.2.6",
    "@radix-ui/react-tabs": "1.1.13",
    "@radix-ui/react-toast": "1.2.15",
    "@radix-ui/react-tooltip": "1.2.8",
    "@tanstack/react-query": "5.90.16",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.2",
    "express": "5.2.1",
    "express-rate-limit": "8.5.2",
    "helmet": "8.1.0",
    "lucide-react": "0.575.0",
    "mammoth": "1.13.0",
    "pg": "8.16.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "tailwind-merge": "3.4.0",
    "unpdf": "1.8.1",
    "wouter": "3.9.0",
    "zod": "4.3.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.18",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/express": "5.0.6",
    "@types/node": "25.2.3",
    "@types/pg": "8.16.0",
    "@types/react": "19.2.8",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.7.0",
    "drizzle-kit": "0.31.8",
    "esbuild": "0.25.12",
    "happy-dom": "20.10.2",
    "tailwindcss": "4.1.18",
    "tsx": "4.21.0",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "vite": "8.1.3",
    "vitest": "4.1.8"
  }
}
